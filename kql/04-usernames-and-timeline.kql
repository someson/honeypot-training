// Phase 3 / 6: which usernames bots try, and attack volume over time.
let MyIPs = dynamic(["203.0.113.10"]);
// --- Top 20 usernames ------------------------------------------------------
SecurityEvent
| where EventID == 4625 and isnotempty(IpAddress) and IpAddress !in ("-", "127.0.0.1", "::1")
| where IpAddress !in (MyIPs)
| extend User = tolower(TargetUserName)
| summarize Attempts = count(), FromIPs = dcount(IpAddress) by User
| top 20 by Attempts
| render barchart

