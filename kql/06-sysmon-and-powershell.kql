// Phase 4 / 5: focused hunting queries. Run one block at a time.
// --- Sysmon EID 1: every process with full command line -------------------------
Event
| where Source == "Microsoft-Windows-Sysmon" and EventID == 1
| extend ed = parse_xml(EventData)
| mv-apply d = ed.DataItem.EventData.Data on (
    summarize f = make_bag(bag_pack(tostring(d["@Name"]), tostring(d["#text"]))))
| project TimeGenerated, User = tostring(f.User), Image = tostring(f.Image),
          CommandLine = tostring(f.CommandLine), Parent = tostring(f.ParentCommandLine)
| where User !has "SYSTEM" and User !has "NETWORK SERVICE" and User !has "LOCAL SERVICE"
| sort by TimeGenerated asc

// --- Without Sysmon: 4688 with command line (needs Enable-AuditPolicy.ps1) ------
